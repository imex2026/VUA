# Copy to .env and fill in. Secrets live here, never in config.yaml.

# Required: the brain runs on Claude.
ANTHROPIC_API_KEY=

# Optional: cloud TTS (speech.tts.backend: elevenlabs in config.yaml).
# ELEVENLABS_API_KEY=

# Optional: full web search for the web_search tool (keyless
# DuckDuckGo fallback is used otherwise).
# BRAVE_SEARCH_API_KEY=

# Optional: tokens referenced as ${VAR} in tools.mcp_servers.
# N8N_MCP_TOKEN=

# Optional cloud services for later phases. Leave empty to stay local.
# OPENAI_API_KEY=
